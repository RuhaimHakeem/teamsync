{
  "expo": {
    "name": "TeamSync",
    "slug": "teamsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "teamsync",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.teamsync.mobile"
    },
    "extra": {
      "router": {
        "root": "app"
      }
    }
  }
}
